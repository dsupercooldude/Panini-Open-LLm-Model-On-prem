# Copy to .env and fill in only the providers you intend to use.
NODE_ENV=development
PORT=3000
PANINI_BIND_HOST=127.0.0.1
PANINI_DB_PATH=./data/panini.sqlite
PANINI_JSON_DB_PATH=./data/panini-local-sovereign-db.json

# Optional local inference and model downloads
OLLAMA_BASE_URL=http://127.0.0.1:11434
PANINI_OLLAMA_MODEL=qwen3.5:4b

# Optional OpenAI-compatible inference, fine-tuning, speech, and transcription
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional export of real GGUF files located in this trusted directory
PANINI_GGUF_EXPORT_DIR=

# Production sign-in (set a unique password with at least 16 characters)
# PANINI_ADMIN_USERNAME=admin
# PANINI_ADMIN_PASSWORD=
# PANINI_TRUST_PROXY=1
